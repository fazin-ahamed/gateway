{
  // Cloudflare Worker entrypoint for HORIZON. Built by `npm run build:edge`
  // (scripts/build-edge.mjs) from src/ with the consumer-web GLM bridge
  // excluded from the bundle; the Node rollback runtime (server/server.mjs +
  // src/index.js) is untouched by this config.
  "name": "horizon-edge",
  "main": ".edge-build/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true,
    // Free tier: minimal structured logs. 100% head sampling was the Node
    // host's setting; it inflates log volume for no benefit on Workers and
    // risks quota. Raise during an incident, not by default.
    "head_sampling_rate": 0.01,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "horizon-edge",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "UPSTREAM_APP_TITLE": "AI Gateway",
    "UPSTREAM_HTTP_REFERER": "https://example.com",
    "UPSTREAM_TIMEOUT_MS": "600000"
  }
}
