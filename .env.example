# Copy this file to .env at the repo root and fill it in.
# .env is gitignored — it will never be committed.
#
# ---- Gateway runtime (required) -------------------------------------------
# Password for the operator console at /_gw.
ADMIN_TOKEN=
# AES-GCM envelope secret that seals provider keys in SQLite. Keep a copy
# safe: losing it makes every sealed provider key unreadable.
PROVIDER_CRYPTO_KEY=

# ---- Optional runtime overrides -------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# DB_PATH=./data/gateway.db
# ZAI_SESSION_STORE_KEY=     # defaults to PROVIDER_CRYPTO_KEY, then ADMIN_TOKEN

# ---- Repo tooling (optional) ----------------------------------------------
# GITHUB_PAT authenticates git pushes to github.com via
# scripts/git-credential-github-pat.sh (already registered in this repo's
# .git/config) and is used by scripts/repo-private.sh to flip visibility.
#
# Token scopes:
#   classic PAT:      `repo` scope
#   fine-grained PAT: Contents: Read and write
#                     (+ Administration: Read and write only if you want
#                      scripts/repo-private.sh to change visibility)
GITHUB_PAT=

# Optional. GitHub PAT auth accepts any non-empty username; the helper
# defaults to x-access-token.
# GITHUB_USERNAME=fazin-ahamed

# D1 mode only (D1_DATABASE_ID + CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN).
# Each statement is an HTTPS round trip, so server/d1.mjs caches operator-config
# SELECTs and batches telemetry writes. Defaults shown; 0 disables each.
# D1_CACHE_TTL_MS=10000
# D1_FLUSH_MS=400
