# Gateway secrets and host settings. Copy to .env (never commit) and fill in.
# Provider credentials do NOT belong here: add them in the console (/_gw ->
# Providers) and they are sealed into the DB with PROVIDER_CRYPTO_KEY.

ADMIN_TOKEN=change-me-to-a-long-random-admin-password
PROVIDER_CRYPTO_KEY=change-me-to-a-long-random-encryption-secret
KOYEB_RELAY_SECRET=change-me-to-a-long-random-value
KOYEB_RELAY_URL=
RELAY_BACKEND=koyeb
# Abort an upstream call if it has sent no response headers after this many ms
# (default 600000). Once headers arrive, streaming bodies are unbounded.
UPSTREAM_TIMEOUT_MS=600000
UPSTREAM_APP_TITLE=AI Gateway
UPSTREAM_HTTP_REFERER=
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/gateway.db

# Optional, experimental: programmatic z.ai captcha minting
# (ai-gateway/src/zai-captcha.js, not wired into any provider yet). Bring your
# own Aliyun captcha credential pair; there is no shared default.
ZAI_CAPTCHA_ACCESS_KEY=
ZAI_CAPTCHA_SECRET_KEY=
ZAI_CAPTCHA_SCENE_ID=didk33e0
