# Gateway secrets and host settings. Copy to .env (never commit) and fill in.
# Provider credentials do NOT belong here: add them in the console (/_gw ->
# Providers) and they are sealed into the DB with PROVIDER_CRYPTO_KEY.

ADMIN_TOKEN=change-me-to-a-long-random-admin-password
PROVIDER_CRYPTO_KEY=change-me-to-a-long-random-encryption-secret
KOYEB_RELAY_SECRET=change-me-to-a-long-random-value
KOYEB_RELAY_URL=
RELAY_BACKEND=koyeb
# Abort an upstream call if it has sent no response headers after this many ms
# (default 600000). Once headers arrive, streaming bodies are unbounded.
UPSTREAM_TIMEOUT_MS=600000
UPSTREAM_APP_TITLE=AI Gateway
UPSTREAM_HTTP_REFERER=
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/gateway.db

# Recommended Z.AI consumer transport: pure HTTP (fmt=zaiminted), based on the
# proven GLM-Free-API lifecycle. The serving host needs no browser or OS
# packages. Harvest device tokens on another browser-capable machine. The
# gateway imports the legacy newline file into its SQLite FIFO automatically
# whenever the DB queue is empty, then clears the file to prevent token reuse.
# ZAI_TOKEN_STORE=./data/zai-device-tokens.txt

# Bring your own Aliyun CAPTCHA credential pair. The gateway deliberately ships
# no shared/default credentials.
ZAI_CAPTCHA_ACCESS_KEY=
ZAI_CAPTCHA_SECRET_KEY=
ZAI_CAPTCHA_SCENE_ID=didk33e0

# Pure-HTTP prefetch/session defaults (same operating model as the reference).
ZAI_CAPTCHA_CACHE_SIZE=2
ZAI_CAPTCHA_CACHE_TTL_MS=75000
ZAI_CAPTCHA_CACHE_IDLE_MS=180000
ZAI_SESSION_POOL_SIZE=5
ZAI_MAX_IMAGES=10
ZAI_MAX_IMAGE_BYTES=52428800

# Browser is now fallback/debug only and automatic fallback is OFF by default.
# Set ZAI_BROWSER_FALLBACK=1 only if this host has a working browser runtime.
# Point BROWSER_EXECUTABLE at an existing
# Chromium on restricted hosts; no apt/Xvfb install is required by pure HTTP.
ZAI_BROWSER_FALLBACK=0
# BROWSER_EXECUTABLE=/home/<user>/.cache/ms-playwright/chromium-1234/chrome-linux64/chrome

# Optional: persist Z.AI cookie jars across gateway restarts. Defaults to
# <dirname(DB_PATH)>/zai-sessions.json.
# ZAI_SESSION_STORE=./data/zai-sessions.json

# Optional: Chrome-TLS helper for signed chat.z.ai calls (relay/cmd/zaihttp).
# Start it with `go run .` in that directory, then point the gateway at it.
# ZAI_UTLS_PROXY=http://127.0.0.1:8477
# ZAI_HTTP_ADDR=127.0.0.1:8477
